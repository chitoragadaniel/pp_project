// Nested thread shared int sum
int i = 10
fork {
  int i = 1
  sum = sum + i
  fork {
    int i = 1
    sum = sum + i
  }
}
while (not(sum == 3)) {}
print(i)
//sep


// Multiple locks
shared int a
shared int b
shared lock la
shared lock lb
fork {
  lock(la)
  a = a+1
  unlock(la)
  lock(lb)
  b=b+2
  unlock(lb)
}
fork {
  lock(lb)
  b=b+2
  unlock(lb)
  lock(la)
  a = a+1
  unlock(la)
}

while (not(a==2 && b==4)) {}
print(a)
print(b)
//sep


